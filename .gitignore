# ── Dependencias ──
node_modules/
functions/node_modules/

# ── Secretos: NUNCA en el repo (van en variables de entorno de Railway
#    o en la consola de Firebase). Esta lista es una red de seguridad para
#    que un archivo de credenciales dejado en la carpeta no se commitee solo.
.env
.env.*
!.env.ejemplo
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
*.pem
*.key
*.p12
*.pfx
afip-*.crt
afip-*.key

# ── Locales / temporales ──
.DS_Store
Thumbs.db
*.log
.firebase/
