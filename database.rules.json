{
  "rules": {
    ".read": false,
    ".write": false,

    "roles": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || (auth.uid === $uid && !root.child('roles').exists() && newData.val() === 'superadmin')"
      }
    },

    "usuarios": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() === 'superadmin')"
      }
    },

    "cajaDiaria": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()",
        ".write": "auth != null && auth.uid === $uid && root.child('roles').child(auth.uid).exists()"
      }
    },

    "empresas": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'",
      "$empresaId": {
        "proyectos": {
          "$proyectoId": {
            "documentos": {
              ".indexOn": ["proveedor"]
            }
          }
        }
      }
    },

    "global": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'"
    },

    "remuneracionesPagos": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },

    "remuneracionesRecibos": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },

    "remuneracionesConsolidados": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },

    "solicitudesBorrado": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "auth != null && root.child('roles').child(auth.uid).exists()"
    },

    "dashboardPagos": {
      ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'"
    },

    "parteObra": {
      "$codigo": {
        ".read":  "$codigo.length >= 20",
        ".write": "$codigo.length >= 20",
        "$seccion": {
          ".validate": "$seccion === 'gremios' || $seccion === 'personal' || $seccion === 'dias'"
        }
      }
    },

    "temp-pdf": {
      "$docId": {
        ".read": true,
        ".write": "auth != null && root.child('roles').child(auth.uid).exists()"
      }
    }
  }
}
