{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || (auth.uid === $uid && !root.child('roles').exists() && newData.val() === 'superadmin')"
      }
    },
    "usuarios": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() === 'superadmin')"
      }
    },
    "cajaDiaria": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
        ".write": "auth != null && auth.uid === $uid && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')"
      }
    },
    "empresas": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'",
      "$empresaId": {
        "proyectos": {
          "$proyectoId": {
            "documentos": {
              ".indexOn": [
                "proveedor"
              ]
            }
          }
        }
      }
    },
    "documentacion": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'"
    },
    "global": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'",
      "edificios": {
        ".read": "auth != null && root.child('roles').child(auth.uid).exists()",
        "$edId": {
          "unidades": {
            ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'posesiones'"
          }
        }
      }
    },
    "remuneracionesPagos": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },
    "remuneracionesRecibos": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },
    "remuneracionesConsolidados": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },
    "remuneracionesActualizacion": {
      ".read": "root.child('roles').child(auth.uid).val() === 'superadmin'",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin'"
    },
    "solicitudesBorrado": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')"
    },
    "dashboardPagos": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')",
      ".write": "root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor'"
    },
    "agendaPosesiones": {
      "$ed": {
        "config": {
          ".read": true,
          ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor')"
        },
        "disponibilidad": {
          ".read": true,
          ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor')"
        },
        "ocupados": {
          ".read": true,
          "$f": {
            "$h": {
              ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor') || (!data.exists() && newData.val() === true && root.child('agendaPosesiones').child($ed).child('disponibilidad').child($f).child($h).val() === true)",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "tokens": {
          ".read": "auth != null && root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones'",
          ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor')",
          "$token": {
            ".read": true,
            ".validate": "newData.hasChildren(['u']) && newData.child('u').isString() && newData.child('u').val().length <= 60",
            "u": {},
            "$other": { ".validate": false }
          }
        },
        "reservas": {
          ".read": "auth != null && root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones'",
          "$token": {
            ".read": true,
            ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'superadmin' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'editor') || (!data.exists() && newData.exists() && root.child('agendaPosesiones').child($ed).child('tokens').child($token).exists())",
            ".validate": "newData.hasChildren(['nombre','dni','tel','mail','personas','fecha','hora','unidad','creada']) && newData.child('unidad').val() === root.child('agendaPosesiones').child($ed).child('tokens').child($token).child('u').val() && newData.child('fecha').isString() && newData.child('fecha').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('hora').isString() && newData.child('hora').val().matches(/^[0-9]{2}$/) && newData.parent().parent().child('ocupados').child(newData.child('fecha').val()).child(newData.child('hora').val()).val() === true && !root.child('agendaPosesiones').child($ed).child('ocupados').child(newData.child('fecha').val()).child(newData.child('hora').val()).exists() && newData.parent().parent().child('disponibilidad').child(newData.child('fecha').val()).child(newData.child('hora').val()).val() === true",
            "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "dni": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "tel": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "mail": { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 120" },
            "personas": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" },
            "apoderado": { ".validate": "newData.isBoolean()" },
            "apoNombre": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "apoDni": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "acompanantes": {
              "$i": {
                ".validate": "newData.hasChildren(['nombre'])",
                "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
                "dni": { ".validate": "newData.isString() && newData.val().length <= 30" },
                "$other": { ".validate": false }
              }
            },
            "notas": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "fecha": {},
            "hora": {},
            "unidad": {},
            "creada": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "temp-pdf": {
      "$docId": {
        ".read": true,
        ".write": "auth != null && (root.child('roles').child(auth.uid).exists() && root.child('roles').child(auth.uid).val() !== 'posesiones')"
      }
    }
  }
}
